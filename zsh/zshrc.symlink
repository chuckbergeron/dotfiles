# Everytime we cd into another directory, we ls as well
function chpwd() {
  emulate -L zsh
  ls -Al
}

# shortcut to this dotfiles path is $ZSH_DOTFILES
export ZSH_DOTFILES=$HOME/.dotfiles


# End of lines configured by zsh-newuser-install
# The following lines were added by compinstall
zstyle :compinstall filename '$HOME/.zshrc'
autoload -Uz compinit
compinit

# load every completion after autocomplete loads
# for config_file ($ZSH_DOTFILES/**/completion.zsh) source $config_file

### Auto-correction can be super annoying
setopt nocorrectall

### DirEnv for PATH changes when `cd`-ing
eval "$(direnv hook $0)"

### Node to PATH
export PATH="/usr/local/opt/node@8/bin:$PATH"


# Which plugins would you like to load? (plugins can be found in ~/.oh-my-zsh/plugins/*)
# Custom plugins may be added to ~/.oh-my-zsh/custom/plugins/
# Example format: plugins=(rails git textmate ruby lighthouse)
plugins=(
  brew
  docker
  gitfast
  git-extras
  npm
  macos
  urltools
  web-search
  yarn
)

# Uncomment following line if you want red dots to be displayed while waiting for completion
COMPLETION_WAITING_DOTS="true"

HIST_STAMPS="yyyy-mm-dd"

# source every .zsh file in this rep
for config_file ($ZSH_DOTFILES/**/*.zsh) source $config_file

# Load and source all 'oh-my-zsh' files
source ~/.oh-my-zsh/oh-my-zsh.sh



### PROMPT
# This overrides the ~/.oh-my-zsh/themes/wedisagree* stuff
# The prompt
PROMPT='%{$fg[cyan]%}[%c] %{$reset_color%}'
# The right-hand prompt
RPROMPT='%{$fg[blue]%}$(git_prompt_info)%{$reset_color%}$(git_prompt_status)%{$reset_color%}'
export ZSH_THEME_GIT_PROMPT_PREFIX="%{$fg[Magenta]%}"
export ZSH_THEME_GIT_PROMPT_DIRTY="%{$fg[yellow]%} ✖" # Ⓓ
export ZSH_THEME_GIT_PROMPT_UNTRACKED="%{$fg[cyan]%} ✱" # ⓣ
export ZSH_THEME_GIT_PROMPT_CLEAN="%{$fg[green]%} ✔" # Ⓞ
export ZSH_THEME_GIT_PROMPT_MODIFIED=""  # ⓜ ⑁


export NVM_DIR="$HOME/.nvm"

# Expose the default node version on PATH for sub-shells (scripts, Claude Code, etc.)
# that don't get zsh function definitions inherited from the parent shell.
# nvm aliases can be partial (e.g. "20"), so we find the latest matching installed version.
if [ -f "$NVM_DIR/alias/default" ]; then
  _nvm_spec="$(cat "$NVM_DIR/alias/default")"
  _nvm_resolved="$(ls -1 "$NVM_DIR/versions/node/" 2>/dev/null \
    | grep -E "^v?${_nvm_spec}(\.|$)" | sort -t. -k1,1V -k2,2n -k3,3n | tail -1)"
  if [ -n "$_nvm_resolved" ] && [ -d "$NVM_DIR/versions/node/$_nvm_resolved/bin" ]; then
    export PATH="$NVM_DIR/versions/node/$_nvm_resolved/bin:$PATH"
  fi
  unset _nvm_spec _nvm_resolved
fi

# Lazy-load nvm — node/npm/npx/yarn are on PATH directly via the block above
_load_nvm() {
  unset -f nvm
  [ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"
  [ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"
}
nvm() { _load_nvm; nvm "$@"; }

export PATH=$PATH:~/Library/Android/sdk/platform-tools/

# use .localrc for SUPER SECRET CRAP that you don't
# want in your public, versioned repo.
if [[ -a ~/.localrc ]]
then
  source ~/.localrc
fi

# cd ~/Git/crypto/pool-together





export PATH="$HOME/.yarn/bin:$HOME/.config/yarn/global/node_modules/.bin:$PATH"

export PATH="$PATH:$HOME/.foundry/bin:$HOME/.cargo/bin:$HOME/.local/share/solana/install/active_release/bin"


# place this after nvm initialization!
autoload -U add-zsh-hook

load-nvmrc() {
  # Skip if nvm isn't loaded yet
  if ! type nvm_find_nvmrc &>/dev/null; then
    return
  fi

  local nvmrc_path
  nvmrc_path="$(nvm_find_nvmrc)"

  if [ -n "$nvmrc_path" ]; then
    local nvmrc_node_version
    nvmrc_node_version=$(nvm version "$(cat "${nvmrc_path}")")

    if [ "$nvmrc_node_version" = "N/A" ]; then
      nvm install
    elif [ "$nvmrc_node_version" != "$(nvm version)" ]; then
      nvm use
    fi
  elif [ -n "$(PWD=$OLDPWD nvm_find_nvmrc)" ] && [ "$(nvm version)" != "$(nvm version default)" ]; then
    echo "Reverting to nvm default version"
    nvm use default
  fi
}

add-zsh-hook chpwd load-nvmrc
# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end
export PATH="$HOME/.local/bin:$PATH"

# Claude wants this for git push:
export SSH_AUTH_SOCK="$HOME/Library/Containers/com.apple.ssh-agent/Documents/sockets/com.apple.ssh-agent"
